# Copy this file to .env for local dev. On Render, set these as the service's
# environment variables instead (Dashboard → your service → Environment).

# Firebase Admin SDK — Project settings → Service accounts → Generate new private key.
# On Render, easier to skip this and use a Secret File instead: Advanced → Add Secret
# File, upload the downloaded JSON as-is named "serviceAccountKey.json" (lands at
# /etc/secrets/serviceAccountKey.json, which src/firebaseAdmin.js reads automatically
# if this env var is empty). For local dev, paste the whole JSON file content here as
# one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# payOS — Kênh thanh toán → lấy ở payOS dashboard.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Comma-separated phone numbers (E.164-ish, same format Firebase Auth gives us,
# e.g. +84901111111) allowed into admin.html. Demo passcode gate is gone once this is set.
ADMIN_PHONE_NUMBERS=

# Public URL of this deployed service, e.g. https://thay-loi-muon-noi.onrender.com
# payOS payment links redirect back here after checkout.
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
